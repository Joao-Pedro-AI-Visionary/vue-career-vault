{
  "name": "vue-career-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Precision Career & Technical Snippet Vault built with Vue 3.5, TypeScript, Pinia, and Vite",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
